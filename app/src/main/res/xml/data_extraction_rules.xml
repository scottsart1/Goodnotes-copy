<?xml version="1.0" encoding="utf-8"?>
<!-- Notes and credentials are excluded from Google cloud backup and device transfer;
     Inkwell has its own explicit backup/export. Voice data (voiceprints, reference clips) and
     the speaker models live in no_backup/ and must never leave the device: the root exclude
     covers them, and the explicit no_backup/ excludes keep it that way if the rules are ever
     narrowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="root" path="no_backup/" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="root" path="no_backup/" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
