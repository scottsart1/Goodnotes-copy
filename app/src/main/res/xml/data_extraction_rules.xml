<?xml version="1.0" encoding="utf-8"?>
<!-- Notes and credentials are excluded from Google cloud backup and device transfer;
     Inkwell has its own explicit backup/export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
