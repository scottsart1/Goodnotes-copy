    <string name="spk_set_engine_openai">OpenAI</string>
    <string name="spk_set_engine_openai_sub">Labels speakers while transcribing. Sends the audio and up to four short voice clips of people you\'ve named to OpenAI. Needs an OpenAI key.</string>
